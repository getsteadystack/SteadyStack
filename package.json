{
  "name": "steadystack",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@cloudflare/workers-types": "^4.20251213.0",
      "next": "^16.1.1",
      "@prisma/client": "^7.2.0",
      "@trpc/server": "^11.7.2",
      "@trpc/client": "^11.7.2",
      "@trpc/tanstack-react-query": "^11.7.2",
      "@tanstack/react-query": "^5.90.12",
      "better-auth": "^1.4.9",
      "alchemy": "^0.82.1",
      "@better-auth/expo": "^1.4.9",
      "resend": "^4.0.0",
      "stripe": "^18.5.0"
    }
  },
  "type": "module",
  "scripts": {
    "postinstall": "bun run db:generate",
    "prepare": "husky",
    "predev": "node scripts/sync-env.js",
    "dev": "turbo dev --filter=!@steadystack/infra --filter=!@steadystack/probe --filter=!steadystack",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:worker": "turbo -F @steadystack/worker dev",
    "cron:local": "bun --cwd apps/worker cron:local",
    "db:push": "turbo -F @steadystack/db db:push",
    "db:studio": "turbo -F @steadystack/db db:studio",
    "db:generate": "turbo -F @steadystack/db db:generate",
    "db:migrate": "turbo -F @steadystack/db db:migrate",
    "db:seed": "turbo -F @steadystack/db db:seed",
    "seed": "bun scripts/seed-monitors.ts",
    "generate:appsumo": "bun scripts/generate-appsumo-codes.ts",
    "import:kuma": "bun scripts/import-uptime-kuma.ts",
    "deploy": "turbo -F @steadystack/infra deploy",
    "destroy": "turbo -F @steadystack/infra destroy",
    "check": "oxlint && oxfmt --write",
    "test": "bun test packages apps/worker apps/web",
    "check-names": "bun scripts/check-filenames.js",
    "check-deps": "turbo depcheck",
    "check-publint": "turbo publint",
    "check-size": "turbo size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "changeset publish",
    "format": "prettier --write .",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@steadystack/env": "workspace:*",
    "@types/inquirer": "^9.0.10",
    "dotenv": "catalog:",
    "next-intl": "4.13.6",
    "port-nuker": "^1.0.8",
    "ws": "8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@cloudflare/workers-types": "catalog:",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@steadystack/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.13.14",
    "depcheck": "^1.4.7",
    "husky": "^9.1.7",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "turbo": "^2.10.11",
    "typescript": "catalog:"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0",
    "nanoid": "^5.1.16",
    "undici": "^7.29.0",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2"
  },
  "packageManager": "bun@1.3.6"
}
