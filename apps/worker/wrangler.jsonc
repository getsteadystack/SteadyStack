{
  "name": "pulseguard-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-24",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "off",
  },
  "browser": {
    "binding": "BROWSER",
  },
  "vars": {
    "NODE_ENV": "production",
    // UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are set as Cloudflare Secrets
    // Run: npx wrangler secret put UPSTASH_REDIS_REST_URL
    // Run: npx wrangler secret put UPSTASH_REDIS_REST_TOKEN
    // CORS_ORIGIN must be set as a Cloudflare Secret in production — no wildcard allowed
    // Run: npx wrangler secret put CORS_ORIGIN
    "SHARD_ID": 0,
    "TOTAL_SHARDS": 1,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  // Local dev config: connect to real remote bindings instead of local simulation
  // This prevents "proxy request failed" errors when crons fire in wrangler dev
  //
  // NOTE: local wrangler dev requires DB_USE_PG_DRIVER=true in .dev.vars.
  // The Neon serverless driver's WebSocket tunnel crashes inside the local
  // workerd build (floods of "internal error; reference = ..." plus Prisma
  // "No database host or connection string" errors); the standard pg driver
  // works. Production ignores the flag and uses the Neon driver.
  // Remaining "internal error" bursts on cron ticks are the known wrangler
  // bug with https subrequests in local dev (workers-sdk#9356) — noise only.
  "dev": {
    "local_protocol": "http",
    "upstream_protocol": "https",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LATENCY_AGGREGATOR",
        "class_name": "LatencyAggregator",
      },
      {
        "name": "MONITOR_CHANNEL",
        "class_name": "MonitorChannel",
      },
      {
        "name": "REGIONAL_PROBE",
        "class_name": "RegionalProbe",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LatencyAggregator"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MonitorChannel"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["RegionalProbe"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "kv_namespaces": [
    {
      "binding": "DNS_CACHE",
      "id": "433c972a19cf4eeb8318fa093548511b",
    },
  ],
  // ─── Cloudflare Queues (Free Plan — dormant) ─────────────────────────────
  // Queues require a paid Cloudflare Workers plan.
  // When upgrading, create the four queues first:
  //
  //   bunx wrangler queues create monitor-checks
  //   bunx wrangler queues create monitor-checks-dlq
  //   bunx wrangler queues create notifications
  //   bunx wrangler queues create notifications-dlq
  //
  // Then un-comment the entire block below and redeploy.
  // "queues": {
  //   "producers": [
  //     // Primary queues — used by the worker to offload excess check work
  //     {
  //       "binding": "CHECK_QUEUE",
  //       "queue": "monitor-checks"
  //     },
  //     {
  //       "binding": "NOTIFICATION_QUEUE",
  //       "queue": "notifications"
  //     },
  //     // DLQ producer bindings — lets the worker inspect / replay dead letters
  //     {
  //       "binding": "MONITOR_CHECKS_DLQ",
  //       "queue": "monitor-checks-dlq"
  //     },
  //     {
  //       "binding": "NOTIFICATIONS_DLQ",
  //       "queue": "notifications-dlq"
  //     }
  //   ],
  //   "consumers": [
  //     // Primary consumers
  //     {
  //       "queue": "monitor-checks",
  //       "max_batch_size": 10,
  //       "max_batch_timeout": 5,
  //       "max_retries": 5,
  //       "dead_letter_queue": "monitor-checks-dlq"
  //     },
  //     {
  //       "queue": "notifications",
  //       "max_batch_size": 10,
  //       "max_batch_timeout": 5,
  //       "max_retries": 5,
  //       "dead_letter_queue": "notifications-dlq"
  //     },
  //     // DLQ consumers — log and alert on unrecoverable messages
  //     {
  //       "queue": "monitor-checks-dlq",
  //       "max_batch_size": 50,
  //       "max_batch_timeout": 30,
  //       "max_retries": 0
  //     },
  //     {
  //       "queue": "notifications-dlq",
  //       "max_batch_size": 50,
  //       "max_batch_timeout": 30,
  //       "max_retries": 0
  //     }
  //   ]
  // }
}
