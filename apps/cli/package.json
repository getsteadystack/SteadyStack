{
  "name": "steadystack",
  "version": "0.1.0",
  "description": "Official CLI for SteadyStack — Monitoring as Code, live debugging, and CI/CD integration",
  "keywords": [
    "ci-cd",
    "cli",
    "devops",
    "monitoring",
    "monitoring-as-code",
    "status-page",
    "steadystack",
    "synthetic-monitoring",
    "uptime"
  ],
  "homepage": "https://steadystack.dev",
  "bugs": {
    "url": "https://github.com/getsteadystack/SteadyStack/issues"
  },
  "license": "Apache-2.0",
  "author": "SteadyStack Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsteadystack/SteadyStack.git",
    "directory": "apps/cli"
  },
  "bin": {
    "pulse": "dist/index.js",
    "ss": "dist/index.js",
    "steadystack": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "bun run build",
    "depcheck": "depcheck --ignores=\"tsx\""
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "inquirer": "^9.2.2",
    "ora": "^8.1.1",
    "table": "^6.9.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
